@echo off
chcp 65001 >nul
cd /d "%~dp0"
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; Write-Host '显真文创工作室 - 模型服务启动'; Write-Host '1 DeepSeek   2 通义千问（百炼）   3 豆包（火山方舟）   4 其他兼容接口'; $choice=Read-Host '选择服务编号（直接回车使用DeepSeek）'; if (-not $choice) { $choice='1' }; $model=''; switch ($choice) { '1' { $base='https://api.deepseek.com/v1'; $model='deepseek-chat' } '2' { $base='https://dashscope.aliyuncs.com/compatible-mode/v1'; $model='qwen-plus' } '3' { $base='https://ark.cn-beijing.volces.com/api/v3' } default { $base=Read-Host '输入兼容接口的HTTPS基础地址' } }; $chosen=Read-Host ('模型名称（直接回车使用 '+$model+'）'); if ($chosen) { $model=$chosen }; if (-not $model) { throw '需要填写服务控制台提供的模型名称或推理接入点ID' }; $secure=Read-Host '输入API Key（输入内容不会显示，不会保存到文件）' -AsSecureString; $pointer=[Runtime.InteropServices.Marshal]::SecureStringToBSTR($secure); try { $env:STUDIO_AI_API_KEY=[Runtime.InteropServices.Marshal]::PtrToStringBSTR($pointer); $env:STUDIO_AI_BASE_URL=$base; $env:STUDIO_AI_MODEL=$model; if (-not $env:STUDIO_AI_API_KEY) { throw 'API Key不能为空' }; Write-Host '启动服务。请不要同时运行普通启动窗口。'; & node --use-env-proxy lan.mjs } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($pointer); Remove-Item Env:STUDIO_AI_API_KEY -ErrorAction SilentlyContinue }"
pause
